{
  "name": "7v7-tranarapp-prototyp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist/test/tests/academy/**/*.test.js dist/test/tests/application/**/*.test.js dist/test/tests/contracts/**/*.test.js dist/test/tests/transactions/**/*.test.js dist/test/tests/migrations/**/*.test.js",
    "test:integration": "node --test --test-concurrency=1 dist/test/tests/integration/**/*.test.js",
    "start": "next start",
    "lint": "next lint",
    "db:migrate:up": "node-pg-migrate up --migrations-dir migrations --ts false",
    "db:migrate:down": "node-pg-migrate down --migrations-dir migrations --ts false",
    "db:migrate:create": "node-pg-migrate create --migrations-dir migrations"
  },
  "dependencies": {
    "next": "14.2.5",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/pg": "^8.20.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "node-pg-migrate": "^8.0.4",
    "typescript": "5.5.4"
  }
}
